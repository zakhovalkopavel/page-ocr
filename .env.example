# page-ocr — copy to .env and fill in. No product-specific names.

PAGE_OCR_BACKEND=local
PAGE_OCR_ENGINE=surya
PAGE_OCR_MODEL=datalab-to/surya-ocr-2.5-gguf
# q8 (default) | bf16 — Modal picks this at call time (one deploy serves both)
PAGE_OCR_QUANT=q8

# Required when PAGE_OCR_BACKEND=modal
PAGE_OCR_MODAL_APP=page-ocr
PAGE_OCR_MODAL_CLASS=PageOcr
PAGE_OCR_MODAL_GPU=T4
PAGE_OCR_MODAL_LLAMA_RELEASE=b12061
PAGE_OCR_MODAL_LLAMA_FLAVOR=ubuntu-cuda-12.8-x64

# Modal tokens — https://modal.com/settings (never commit real values)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
